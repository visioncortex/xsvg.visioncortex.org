<svg xmlns="http://www.w3.org/2000/svg" xmlns:x="https://xsvg.visioncortex.org"
     viewBox="0 0 560 360" font-family="'Helvetica Neue', Arial, sans-serif">
  <rect x="0" y="0" width="560" height="360" fill="#ffffff"/>

  <!-- a single curved Coons patch: four corner colours on four edge cubics,
       compiled to a tiny texel-aligned PNG no browser can draw natively -->
  <defs>
    <meshgradient id="coons" x="75" y="98">
      <meshrow>
        <meshpatch>
          <stop path="c 108,-54 306,54 414,18" style="stop-color:#fbbf24"/>
          <stop path="c 27,54 -27,108 9,158" style="stop-color:#f472b6"/>
          <stop path="c -108,54 -306,-54 -414,-14" style="stop-color:#7c3aed"/>
          <stop path="c -18,-54 18,-108 -9,-162" style="stop-color:#0ea5e9"/>
        </meshpatch>
      </meshrow>
    </meshgradient>
  </defs>
  <rect x="24" y="40" width="512" height="284" fill="url(#coons)"/>

  <!-- the patch wireframe: the same edge cubics, drawn live over the baked field -->
  <path d="M75,98 c108,-54 306,54 414,18 c27,54 -27,108 9,158 c-108,54 -306,-54 -414,-14 c-18,-54 18,-108 -9,-162 Z"
        fill="none" stroke="#0f172a" stroke-width="1.2" stroke-dasharray="5 4" opacity="0.7"/>
</svg>
